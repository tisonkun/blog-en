---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Giscus from "@/components/Giscus.astro";
import PostMeta from "@/components/PostMeta.astro";
import PostSidebar from "@/components/PostSidebar.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import { Site } from "@/config";
import { getAllPosts } from "@/lib/post";

interface Props {
    entry: CollectionEntry<"posts">;
}

export async function getStaticPaths() {
    const posts = await getAllPosts();
    return posts.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;

const title = entry.data.title;
const description = entry.data.description;
const category = entry.data.category;
const tags = entry.data.tags;
const frontmatter = entry.data;
const ogImageAbsoluteUrl = `${Site.baseUrl}/images/og.png`;
const publicBaseUrl = Site.baseUrl.includes("localhost") ? "https://www.tisonkun.io" : Site.baseUrl;
const shareUrl = `${publicBaseUrl}/posts/${slug}`;
const { Content, headings } = await render(entry);
---

<BaseLayout title={title}>
    <PostMeta
        title={title}
        description={description}
        publishDate={frontmatter.date.toISOString()}
        pagePath={`/posts/${slug}`}
        ogImageAbsoluteUrl={ogImageAbsoluteUrl}
        slot="meta"
    />
    <article class="pt-8">
        <header class="pb-4 mb-8 border-b border-gray-900/10">
            <h1 class="my-2 text-black leading-tight">{entry.data.title}</h1>
        </header>
        <div class="post-layout">
            <div class="post-main">
                <div class="post-content">
                    <Content />
                </div>
                <div class="flex flex-row">
                    <p class="basis-1/12 min-w-[4.75rem] shrink-0">Category</p>
                    <p class="grow">
                        <a
                            class="ml-2 inline-block border border-blue-600 px-2 rounded"
                            href={`/categories/${category}`}
                        >
                            {category}
                        </a>
                    </p>
                </div>
                <div class="flex flex-row">
                    <p class="basis-1/12 min-w-[4.75rem] shrink-0">Tags</p>
                    <p class="grow">
                        {
                            tags.map((tag) => (
                                <a
                                    class="mt-1 ml-2 inline-block border border-blue-600 px-2 rounded"
                                    href={`/tags/${tag}`}
                                >
                                    {" "}
                                    {tag}{" "}
                                </a>
                            ))
                        }
                    </p>
                </div>
                <div class="post-inline-share">
                    <ShareButtons title={title} shareUrl={shareUrl} />
                </div>
            </div>
            <PostSidebar headings={headings} title={title} shareUrl={shareUrl} />
        </div>
    </article>
    <hr class="border-gray-200 mt-10 mb-4" />
    <Giscus />
</BaseLayout>
