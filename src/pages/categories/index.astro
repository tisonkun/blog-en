---
import { countTerms, getListedPosts } from "@/lib/post";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMeta from "@/components/PageMeta.astro";

const posts = await getListedPosts();
const sortedCategories = countTerms(posts.map((entry) => entry.data.category));
const title = "Categories";
---

<BaseLayout title={title}>
    <PageMeta title={title} slot="meta" />
    <div class="mx-auto">
        <h1 class="text-center text-5xl">{title}</h1>
        <div class="mt-8">
            {
                sortedCategories.map(({ name: category, count }) => (
                    <a
                        class="border-6 border-transparent m-2 rounded text-xl"
                        href={`/categories/${category}`}
                    >
                        {category}
                        <sup>{count}</sup>
                    </a>
                ))
            }
        </div>
    </div>
</BaseLayout>
