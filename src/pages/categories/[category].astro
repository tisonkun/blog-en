---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { titleCase } from "title-case";
import PageMeta from "@/components/PageMeta.astro";
import PostList from "@/components/PostList.astro";
import { getListedPosts } from "@/lib/post";

interface Props {
    posts: CollectionEntry<"posts">[];
    category: string;
}

export async function getStaticPaths() {
    const posts = await getListedPosts();
    const categories = new Map<string, CollectionEntry<"posts">[]>();
    for (const post of posts) {
        const category = post.data.category;
        const list = categories.get(category) ?? [];
        list.push(post);
        categories.set(category, list);
    }
    return [...categories.entries()].map(([category, posts]) => ({
        params: { category },
        props: { posts, category },
    }));
}

const { posts, category } = Astro.props;
const title = titleCase(category);
---

<BaseLayout title={title}>
    <PageMeta title={title} slot="meta" />
    <h1 class="text-center text-5xl">{title}</h1>
    <PostList posts={posts} />
</BaseLayout>
