---
import type { CollectionEntry } from "astro:content";
import { getListedPosts } from "@/lib/post";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { titleCase } from "title-case";
import PageMeta from "@/components/PageMeta.astro";
import PostList from "@/components/PostList.astro";

interface Props {
    posts: CollectionEntry<"posts">[];
    tag: string;
}

export async function getStaticPaths() {
    const posts = await getListedPosts();
    const tags = new Map<string, CollectionEntry<"posts">[]>();
    for (const post of posts) {
        for (const tag of post.data.tags) {
            const list = tags.get(tag) ?? [];
            list.push(post);
            tags.set(tag, list);
        }
    }
    return [...tags.entries()].map(([tag, posts]) => ({
        params: { tag },
        props: { posts, tag },
    }));
}

const { posts, tag } = Astro.props;
const title = titleCase(tag);
---

<BaseLayout title={title}>
    <PageMeta title={title} slot="meta" />
    <h1 class="text-center text-5xl">{title}</h1>
    <PostList posts={posts} />
</BaseLayout>
