---
import { Site } from "@/config";
---

<header class="mt-8">
    <h1 class="text-center lg:text-left text-4xl text-gray-900 font-medium m-0">
        <a
            class="inline-flex items-center gap-3 text-gray-900 hover:text-gray-700 font-display tracking-[-0.02em]"
            href={Site.url}
        >
            <svg
                class="w-9 h-9 shrink-0"
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
            >
                <rect x="2" y="2" width="60" height="60" rx="14" fill="#19191F" />
                <rect x="17" y="16" width="7.5" height="32" rx="1.5" fill="#FAFAFC" />
                <rect x="29" y="16" width="3" height="32" rx="1.2" fill="#FAFAFC" />
                <circle cx="42.5" cy="25.5" r="3.8" fill="#FAFAFC" />
                <circle cx="42.5" cy="38.5" r="3.8" fill="#3B82F6" />
            </svg>
            <span>{Site.title}</span>
        </a>
    </h1>
    <div class="lg:flex items-center text-center justify-between">
        <p class="text-lg text-gray-600">{Site.description}</p>
        <nav class="my-0" aria-label="Social links">
            <ul class="my-0 justify-center flex items-center gap-4 list-none p-0">
                <li class="list-none">
                    <a
                        class="inline-flex items-center text-gray-600 hover:text-gray-900"
                        href="/rss.xml"
                        aria-label="RSS"
                    >
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="6.18" cy="17.82" r="2.18" />
                            <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
                        </svg>
                    </a>
                </li>
                <li class="list-none">
                    <a
                        class="inline-flex items-center text-gray-600 hover:text-gray-900"
                        href="https://github.com/tisonkun"
                        aria-label="GitHub"
                    >
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.26 5.68.42.36.79 1.07.79 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
                        </svg>
                    </a>
                </li>
                <li class="list-none">
                    <a
                        class="inline-flex items-center text-gray-600 hover:text-gray-900"
                        href="https://x.com/tison1096"
                        aria-label="X"
                    >
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    <nav class="text-center border-t border-b border-gray-900/10 px-1 mt-4">
        <ul class="list-disc list-inside">
            {
                Site.menu.navs.map(({ name, url }) => (
                    <li class="inline-block list-none mx-4">
                        <a href={url}>{name}</a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
