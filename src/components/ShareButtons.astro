---
interface Props {
    title: string;
    shareUrl: string;
}

const { title, shareUrl } = Astro.props;

const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(shareUrl);

const platforms = [
    {
        id: "x",
        label: "Share on X",
        href: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    },
    {
        id: "linkedin",
        label: "Share on LinkedIn",
        href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    },
    {
        id: "hn",
        label: "Submit to Hacker News",
        href: `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodedTitle}`,
    },
    {
        id: "reddit",
        label: "Share on Reddit",
        href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`,
    },
] as const;
---

<div class="share-section" data-share-root data-share-title={title}>
    <div class="share-header">
        <span class="share-label">Share</span>
        <span class="share-status" data-share-status aria-live="polite">Copied!</span>
    </div>
    <div class="share-row">
        {
            platforms.map(({ id, label, href }) => (
                <a
                    class="share-btn"
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={label}
                    title={label}
                    data-share-platform={id}
                >
                    {id === "x" && (
                        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="currentColor">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                    )}
                    {id === "linkedin" && (
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z" />
                        </svg>
                    )}
                    {id === "hn" && (
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
                            <path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm7.2 10.6V18h1.6v-4.4L16.5 6h-1.8l-2.7 5.7L9.3 6H7.5l3.7 7.6z" />
                        </svg>
                    )}
                    {id === "reddit" && (
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="14" rx="6.5" ry="4.5" stroke-width="1.75" />
                            <circle cx="4.8" cy="12.5" r="1.4" stroke-width="1.5" />
                            <circle cx="19.2" cy="12.5" r="1.4" stroke-width="1.5" />
                            <path d="M12 9.5 13.5 5l3 .8" stroke-width="1.7" />
                            <circle cx="17.6" cy="6" r="1.15" stroke-width="1.5" />
                            <circle cx="9.6" cy="13.4" r="0.9" fill="currentColor" stroke="none" />
                            <circle cx="14.4" cy="13.4" r="0.9" fill="currentColor" stroke="none" />
                            <path d="M9.6 15.8a4.2 4.2 0 0 0 4.8 0" stroke-width="1.5" />
                        </svg>
                    )}
                </a>
            ))
        }
        <button
            type="button"
            class="share-btn"
            aria-label="Copy link"
            title="Copy link"
            data-copy-link
        >
            <svg
                class="share-icon-copy"
                viewBox="0 0 24 24"
                width="15"
                height="15"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            <svg
                class="share-icon-check"
                viewBox="0 0 24 24"
                width="15"
                height="15"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M5 13l4 4L19 7" />
            </svg>
        </button>
    </div>
</div>

<style>
    .share-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    .share-label {
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #9ca3af;
        line-height: 1.3;
    }

    .share-status {
        font-size: 11.5px;
        font-weight: 500;
        color: #16a34a;
        opacity: 0;
        transition: opacity 150ms ease;
    }

    .share-status.is-visible {
        opacity: 1;
    }

    .share-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .share-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 0.375rem;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #6b7280;
        text-decoration: none;
        cursor: pointer;
        transition:
            color 150ms ease,
            border-color 150ms ease,
            background-color 150ms ease;
    }

    .share-btn:hover {
        color: #111827;
        border-color: #9ca3af;
        background: #f9fafb;
    }

    .share-icon-check {
        display: none;
        color: #16a34a;
    }

    .share-btn[data-copied="true"] .share-icon-copy {
        display: none;
    }

    .share-btn[data-copied="true"] .share-icon-check {
        display: block;
    }

    .share-btn[data-copied="true"] {
        border-color: #86efac;
        background: #f0fdf4;
    }
</style>
